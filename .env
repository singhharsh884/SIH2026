# =================================================================
# KisanDirect - Environment Configuration
# =================================================================

# Backend API Endpoint (empty in production to use relative /api)
VITE_API_URL=


# -----------------------------------------------------------------
# MAP TILE API KEYS (ALL OPTIONAL!)
# Note: The built-in Esri Dark Gray, Esri Satellite, and OpenStreetMap 
# modes are 100% FREE and require NO API KEY whatsoever.
# -----------------------------------------------------------------

# Optional: CARTO API Key (if you wish to use CARTO Dark Matter without watermark)
# Get a free key at: https://carto.com/
VITE_CARTO_API_KEY=

# Optional: Mapbox Public Access Token (for Mapbox Dark / Streets)
# Get a free token at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# Optional: Stadia Maps API Key
# Get a free key at: https://stadiamaps.com/
VITE_STADIA_API_KEY=

# Optional: Google Maps Platform API Key
# Get a key at: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=
